<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.4.0</Version>
    <Product>OpenCrosshair</Product>
    <Description>Free, open-source crosshair overlay for Windows.</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenCrosshair.Tests" />
    <!-- Also built in, for the windows and the tray (made by tools/make-icon.ps1) -->
    <EmbeddedResource Include="app.ico" LogicalName="OpenCrosshair.app.ico" />
    <!-- Translations: English text → translated text, one file per language -->
    <EmbeddedResource Include="lang\*.json" LogicalName="OpenCrosshair.lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

</Project>
